# 必填
OPENAI_API_KEY=
# 可选:覆盖默认模型
OPENWB_MODEL=bai/deepseek-v4-flash
# 可选:自定义 baseURL(兼容 OpenAI 协议的第三方网关)
OPENAI_BASE_URL=
# 离线自检:设为 1 时不调用模型
OPENWB_MOCK=0
# 可选:工作流联网检索 provider(auto 有配置就用真实检索,无配置退回离线样例)
# provider 可选 tavily / brave / serper / searxng
OPENWB_WEB_SEARCH=auto
OPENWB_SEARCH_PROVIDER=
# 对应 provider 的 Key(任选其一;searxng 不需要 Key)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
# searxng 必填:实例的 /search 地址
OPENWB_SEARCH_ENDPOINT=
# 可选:工作流网页抓取(auto 在 OPENWB_MOCK=1 时离线,其余真实抓取)
OPENWB_WEB_FETCH=auto
# 仅本地验收可置 1,允许抓取回环/私网地址;生产不要开启
OPENWB_WEB_FETCH_ALLOW_PRIVATE=0
